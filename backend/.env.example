# Copy to backend/.env for local development. Never commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=gitcontext

PINECONE_API_KEY=pcsk_replace_me
PINECONE_INDEX_NAME=gitcontext-code
PINECONE_DIMENSION=768

JINA_API_KEY=jina_replace_me
JINA_EMBEDDING_MODEL=jina-embeddings-v2-base-code

GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Raises GitHub API rate limits for public repository indexing.
GITHUB_TOKEN=

FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=40
MAX_REPOSITORY_FILES=1200
MAX_FILE_BYTES=500000
MAX_CODE_CHUNKS=3000
MAX_DOCUMENT_MB=20
MAX_DOCUMENT_PAGES=300
MAX_DOCUMENT_CHUNKS=1200
